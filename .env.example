# ==============================================================================
# Education Committee Examination Portal — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in backend/ or root, and customize for your deployment environment.
# NEVER commit the actual .env file or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. MongoDB Database Configuration
# ------------------------------------------------------------------------------
# Production connection URI (Atlas SRV or standalone replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/education_committee?retryWrites=true&w=majority
# Connection pool tuning (recommended: max 50 for production, min 5)
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# ------------------------------------------------------------------------------
# 3. Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Production JWT Secret: Must be at least 32 characters (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_32_plus_char_secret_in_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=auth_token

# ------------------------------------------------------------------------------
# 4. CORS & Reverse Proxy
# ------------------------------------------------------------------------------
# Comma-separated list of trusted client origins. Wildcard '*' is strictly prohibited in production.
CLIENT_ORIGIN=https://portal.educationcommittee.org

# ------------------------------------------------------------------------------
# 5. Rate Limiting & Request Guards
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BODY_LIMIT=1mb

# ------------------------------------------------------------------------------
# 6. Internal OMR Microservice Integration
# ------------------------------------------------------------------------------
# Fast Python/OpenCV vision service URL (private loopback or internal subnet only)
OMR_SERVICE_URL=http://127.0.0.1:8001
# Internal service authentication key (must match microservice configuration)
OMR_INTERNAL_KEY=replace_with_strong_internal_microservice_key_at_least_16_chars
# Private filesystem path for scanned and rectified OMR submissions (never publicly exposed)
OMR_STORAGE_DIR=./storage/omr_private
