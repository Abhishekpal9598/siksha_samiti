# Server Environment Configuration (Placeholders only - DO NOT commit real secrets)
PORT=5000
NODE_ENV=development
TIMEZONE=Asia/Kolkata

# Database
MONGODB_URI=mongodb://localhost:27017/shiksha_samiti_competition

# Authentication & Sessions
JWT_SECRET=replace_with_a_secure_random_secret_in_production
SESSION_COOKIE_SECRET=replace_with_secure_cookie_secret
TOKEN_EXPIRES_IN=24h

# Internal OMR Microservice
OMR_SERVICE_URL=http://localhost:8000
OMR_SERVICE_SECRET=replace_with_internal_shared_secret

# Uploads & Storage
UPLOAD_STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=8388608

# CORS
CLIENT_ORIGIN=http://localhost:5173
