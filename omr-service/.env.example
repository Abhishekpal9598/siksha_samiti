# ==============================================================================
# Education Committee OMR Vision Microservice — Environment Configuration
# ==============================================================================
# Configure in Render Web Service Dashboard > Environment Variables
# or in omr-service/.env for local development. NEVER commit actual secrets.
# ==============================================================================

# Port (Render automatically sets PORT in production; default 8001 for local)
PORT=8001
OMR_SERVICE_HOST=0.0.0.0

# Internal Shared Secret Key
# Must match OMR_INTERNAL_KEY configured in the Node.js backend.
# Min 16 characters (generate with: openssl rand -hex 24)
OMR_INTERNAL_KEY=replace_with_strong_internal_microservice_key_at_least_16_chars
