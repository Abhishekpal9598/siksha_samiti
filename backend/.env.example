# ==============================================================================
# Education Committee Examination Portal — Backend Environment Template
# ==============================================================================
# Configure these variables in Render Dashboard > Environment Variables
# or in backend/.env for local development. NEVER commit actual secrets.
# ==============================================================================

# 1. Server Environment
PORT=5000
NODE_ENV=production
TIMEZONE=Asia/Kolkata

# 2. MongoDB Database Configuration (MongoDB Atlas Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/education_committee?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# 3. Authentication & Security Secrets
# Minimum 32 characters (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_32_plus_char_secret_in_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=auth_token

# Cookie Cross-Site Policy:
# Use 'none' when frontend (Vercel) and backend (Render) are on different domains.
# Use 'lax' when frontend and backend share the same domain or on local/VPS.
COOKIE_SAME_SITE=none

# 4. CORS Whitelist
# Include your Vercel frontend URL (comma-separated if multiple, e.g. custom domain)
CLIENT_ORIGIN=https://shiksha-samiti.vercel.app,https://portal.educationcommittee.org

# 5. Rate Limiting & Guards
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BODY_LIMIT=1mb

# 6. Internal Python OMR Microservice
# On Render: Use the internal/external service URL of your Render Python Web Service
OMR_SERVICE_URL=https://shiksha-samiti-omr.onrender.com
# Internal shared secret (min 16 characters; must match Python service)
OMR_INTERNAL_KEY=replace_with_strong_internal_microservice_key_at_least_16_chars

# 7. Private File Storage Strategy
# Set to 'local' for local development & VPS with persistent SSD.
# Set to 's3' for ephemeral cloud containers (Render) with Cloudflare R2 / AWS S3 / Supabase.
STORAGE_PROVIDER=local
OMR_STORAGE_DIR=./storage/omr_private

# Optional S3 Cloud Object Storage Settings (for STORAGE_PROVIDER=s3):
# S3_BUCKET=education-omr-private
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=replace_with_r2_or_s3_access_key
# S3_SECRET_ACCESS_KEY=replace_with_r2_or_s3_secret_key
