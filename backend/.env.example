PORT=5000
NODE_ENV=development
TIMEZONE=Asia/Kolkata
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
